{
  "name": "vansh-enterprises-backend",
  "version": "1.0.0",
  "description": "Backend API for Vansh Enterprises B2B Marketplace",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "render-build": "npm install && npm run build"
  },
  "engines": {
    "node": "18.x"
  },
  "dependencies": {
