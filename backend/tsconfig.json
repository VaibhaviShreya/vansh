{
  "compilerOptions": {
    "target": "ES2019",
    "module": "Node16",
    "moduleResolution": "Node16",

    "types": [
      "node",
      "express"
    ],

    "lib": ["ES2019"],

    "outDir": "./dist",
    "rootDir": "./src",

    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  }
}